# Copiare questo file in .env.staging.local.
# Il file locale è escluso da Git. Usare soltanto il progetto Firebase di
# staging e dati fittizi; non inserire chiavi amministrative o account di
# servizio nel frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=bike4city-ciclofficina
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Deve restare vuoto nei file: usare una variabile temporanea della sessione.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Obbligatorio per impedire che la build staging punti agli emulatori.
VITE_USE_FIREBASE_EMULATORS=false
