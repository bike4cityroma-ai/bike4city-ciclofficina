# Configurazione pubblica del client Firebase.
# Copiare in .env.local e inserire i valori del proprio ambiente.
# Non inserire mai credenziali amministrative o chiavi private.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Sviluppo locale. Lasciare true per impedire collegamenti accidentali al cloud.
VITE_USE_FIREBASE_EMULATORS=true
