{
  "name": "bike4city-ciclofficina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "functions:build": "npm.cmd --prefix functions run build",
    "emulators:seed": "npm.cmd run functions:build && npm.cmd --prefix functions run seed",
    "emulators": "node scripts/firebase-emulators.mjs start",
    "emulators:exec": "node scripts/firebase-emulators.mjs exec",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:rules": "vitest run tests/firestore.rules.test.ts",
    "test:emulators": "npm.cmd run test:rules && npm.cmd --prefix functions run test:emulator && npm.cmd run emulators:seed",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "firebase": "12.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "firebase-tools": "15.24.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
